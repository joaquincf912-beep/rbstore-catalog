rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// RBstore — Reglas de seguridad de Firestore (DEFINITIVAS / versión estricta)
// Proyecto: rbstore-a959f   ·   Dueño: rrodriguezcesar00@gmail.com
// Actualizado: 17/09/2026
//
// QUÉ HACEN:
//   · Cualquier visitante PUEDE LEER el catálogo (la tienda funciona).
//   · SOLO tu cuenta (rrodriguezcesar00@gmail.com) PUEDE ESCRIBIR.
//     Ni un anónimo ni una cuenta nueva inventada pueden tocar el catálogo.
//
// CÓMO APLICAR:
//   Firebase Console → Firestore Database → pestaña "Reglas"
//   → borra todo, pega este archivo → Publicar.
//
// RECORDATORIO: en el sitio, entra al Panel Dueño con tu correo y tu
// contraseña (no con la clave 2828) para que tus cambios se publiquen.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Único dueño autorizado. Comparación en minúsculas para evitar
    // problemas de mayúsculas/minúsculas.
    function esDueno() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'rrodriguezcesar00@gmail.com';
    }

    // Catálogo de productos
    match /productos/{productId} {
      allow read: if true;                 // los clientes ven la tienda
      allow create, update, delete: if esDueno();
    }

    // Categorías
    match /categorias/{categoryId} {
      allow read: if true;                 // los clientes ven las categorías
      allow create, update, delete: if esDueno();
    }

    // Cualquier otra colección: privada, nadie la puede leer ni escribir
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
