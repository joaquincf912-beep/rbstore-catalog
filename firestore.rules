rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// RBstore — Reglas de seguridad de Firestore (DEFINITIVAS)
// Proyecto: rbstore-a959f
//
// QUÉ HACEN:
//   · Cualquier visitante PUEDE LEER el catálogo (la tienda funciona).
//   · SOLO un usuario con sesión de Firebase Auth PUEDE ESCRIBIR.
//     Sin sesión, Firestore rechaza cualquier cambio (adiós vandalismo).
//
// CÓMO APLICAR:
//   Firebase Console → Firestore Database → pestaña "Reglas"
//   → borra todo, pega este archivo → Publicar.
//
// ANTES DE PUBLICAR (obligatorio, o tu panel no podrá guardar):
//   Firebase Console → Authentication → Users → Add user:
//     correo: el tuyo   ·   contraseña: la que quieras
//   En el sitio: Panel Dueño → escribe ese correo y esa contraseña.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo cuentas ya creadas por ti (no hay registro público abierto).
    function esDueno() {
      return request.auth != null;
    }

    // ── OPCIÓN MÁS ESTRICTA (recomendada) ──────────────────────
    // Descomenta estas 3 líneas y escribe tu correo para que
    // SOLO esa cuenta pueda escribir, aunque alguien más se
    // registrara en tu proyecto:
    //
    // function esDueno() {
    //   return request.auth != null
    //     && request.auth.token.email == 'TU_CORREO@AQUI.COM';
    // }
    // ───────────────────────────────────────────────────────────

    // Catálogo de productos
    match /productos/{productId} {
      allow read: if true;                 // los clientes ven la tienda
      allow create, update, delete: if esDueno();
    }

    // Categorías
    match /categorias/{categoryId} {
      allow read: if true;                 // los clientes ven las categorías
      allow create, update, delete: if esDueno();
    }

    // Cualquier otra colección: privada, nadie la puede leer ni escribir
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
